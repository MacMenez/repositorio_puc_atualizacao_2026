<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.cgts.com/pizza#"
     xml:base="http://www.cgts.com/pizza"
     xmlns:dc="http://purl.org/dc/elements/1.1/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:pizza="http://www.co-ode.org/ontologies/pizza/pizza.owl#"
     xmlns:terms="http://purl.org/dc/terms/">
    <owl:Ontology rdf:about="http://www.cgts.com/pizza">
        <owl:versionIRI rdf:resource="http://www.cgts.com/pizza/2"/>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://purl.org/dc/elements/1.1/description -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/description"/>
    


    <!-- http://purl.org/dc/elements/1.1/title -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/title"/>
    


    <!-- http://purl.org/dc/terms/contributor -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/contributor"/>
    


    <!-- http://purl.org/dc/terms/license -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/license"/>
    


    <!-- http://purl.org/dc/terms/provenance -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/provenance"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#altLabel -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#altLabel"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#definition -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#definition"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#prefLabel -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#prefLabel"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.cgts.com/pizza#hasPrice -->

    <owl:ObjectProperty rdf:about="http://www.cgts.com/pizza#hasPrice">
        <rdfs:domain rdf:resource="http://www.cgts.com/pizza/pizza.owl#Food"/>
    </owl:ObjectProperty>
    


    <!-- http://www.cgts.com/pizza/pizza.owl#hasBase -->

    <owl:ObjectProperty rdf:about="http://www.cgts.com/pizza/pizza.owl#hasBase">
        <rdfs:subPropertyOf rdf:resource="http://www.cgts.com/pizza/pizza.owl#hasIngredient"/>
        <owl:inverseOf rdf:resource="http://www.cgts.com/pizza/pizza.owl#isBaseOf"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.cgts.com/pizza/pizza.owl#Pizza"/>
        <rdfs:range rdf:resource="http://www.cgts.com/pizza/pizza.owl#PizzaBase"/>
    </owl:ObjectProperty>
    


    <!-- http://www.cgts.com/pizza/pizza.owl#hasCountryOfOrigin -->

    <owl:ObjectProperty rdf:about="http://www.cgts.com/pizza/pizza.owl#hasCountryOfOrigin"/>
    


    <!-- http://www.cgts.com/pizza/pizza.owl#hasIngredient -->

    <owl:ObjectProperty rdf:about="http://www.cgts.com/pizza/pizza.owl#hasIngredient">
        <owl:inverseOf rdf:resource="http://www.cgts.com/pizza/pizza.owl#isIngredientOf"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:domain rdf:resource="http://www.cgts.com/pizza/pizza.owl#Food"/>
        <rdfs:range rdf:resource="http://www.cgts.com/pizza/pizza.owl#Food"/>
        <rdfs:comment xml:lang="en">NB Transitive - the ingredients of ingredients are ingredients of the whole</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.cgts.com/pizza/pizza.owl#hasSpiciness -->

    <owl:ObjectProperty rdf:about="http://www.cgts.com/pizza/pizza.owl#hasSpiciness">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:range rdf:resource="http://www.cgts.com/pizza/pizza.owl#Spiciness"/>
        <rdfs:comment xml:lang="en">A property created to be used with the ValuePartition - Spiciness.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.cgts.com/pizza/pizza.owl#hasTopping -->

    <owl:ObjectProperty rdf:about="http://www.cgts.com/pizza/pizza.owl#hasTopping">
        <rdfs:subPropertyOf rdf:resource="http://www.cgts.com/pizza/pizza.owl#hasIngredient"/>
        <owl:inverseOf rdf:resource="http://www.cgts.com/pizza/pizza.owl#isToppingOf"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.cgts.com/pizza/pizza.owl#Pizza"/>
        <rdfs:range rdf:resource="http://www.cgts.com/pizza/pizza.owl#PizzaTopping"/>
        <rdfs:comment xml:lang="en">Note that hasTopping is inverse functional because isToppingOf is functional</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.cgts.com/pizza/pizza.owl#isBaseOf -->

    <owl:ObjectProperty rdf:about="http://www.cgts.com/pizza/pizza.owl#isBaseOf">
        <rdfs:subPropertyOf rdf:resource="http://www.cgts.com/pizza/pizza.owl#isIngredientOf"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
    </owl:ObjectProperty>
    


    <!-- http://www.cgts.com/pizza/pizza.owl#isIngredientOf -->

    <owl:ObjectProperty rdf:about="http://www.cgts.com/pizza/pizza.owl#isIngredientOf">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:comment xml:lang="en">The inverse property tree to hasIngredient - all subproperties and attributes of the properties should reflect those under hasIngredient.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.cgts.com/pizza/pizza.owl#isToppingOf -->

    <owl:ObjectProperty rdf:about="http://www.cgts.com/pizza/pizza.owl#isToppingOf">
        <rdfs:subPropertyOf rdf:resource="http://www.cgts.com/pizza/pizza.owl#isIngredientOf"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:comment xml:lang="en">Any given instance of topping should only be added to a single pizza (no cheap half-measures on our pizzas)</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.cgts.com/pizza#population -->

    <owl:DatatypeProperty rdf:about="http://www.cgts.com/pizza#population">
        <rdfs:domain rdf:resource="http://www.cgts.com/pizza/pizza.owl#Country"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.cgts.com/pizza#price -->

    <owl:DatatypeProperty rdf:about="http://www.cgts.com/pizza#price">
        <rdfs:domain rdf:resource="http://www.cgts.com/pizza/pizza.owl#Food"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.cgts.com/pizza/pizza.owl#American -->

    <owl:Class rdf:about="http://www.cgts.com/pizza/pizza.owl#American">
        <rdfs:subClassOf rdf:resource="http://www.cgts.com/pizza/pizza.owl#NamedPizza"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.cgts.com/pizza/pizza.owl#hasTopping"/>
                <owl:someValuesFrom rdf:resource="http://www.cgts.com/pizza/pizza.owl#MozzarellaTopping"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.cgts.com/pizza/pizza.owl#hasTopping"/>
                <owl:someValuesFrom rdf:resource="http://www.cgts.com/pizza/pizza.owl#PeperoniSausageTopping"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.cgts.com/pizza/pizza.owl#hasTopping"/>
                <owl:someValuesFrom rdf:resource="http://www.cgts.com/pizza/pizza.owl#TomatoTopping"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.cgts.com/pizza/pizza.owl#hasTopping"/>
                <owl:allValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://www.cgts.com/pizza/pizza.owl#MozzarellaTopping"/>
                            <rdf:Description rdf:about="http://www.cgts.com/pizza/pizza.owl#PeperoniSausageTopping"/>
                            <rdf:Description rdf:about="http://www.cgts.com/pizza/pizza.owl#TomatoTopping"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.cgts.com/pizza/pizza.owl#hasCountryOfOrigin"/>
                <owl:hasValue rdf:resource="http://www.cgts.com/pizza/pizza.owl#America"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://www.cgts.com/pizza/pizza.owl#AmericanHot -->

    <owl:Class rdf:about="http://www.cgts.com/pizza/pizza.owl#AmericanHot">
        <rdfs:subClassOf rdf:resource="http://www.cgts.com/pizza/pizza.owl#NamedPizza"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.cgts.com/pizza/pizza.owl#hasTopping"/>
                <owl:someValuesFrom rdf:resource="http://www.cgts.com/pizza/pizza.owl#HotGreenPepperTopping"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.cgts.com/pizza/pizza.owl#hasTopping"/>
                <owl:someValuesFrom rdf:resource="http://www.cgts.com/pizza/pizza.owl#JalapenoPepperTopping"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.cgts.com/pizza/pizza.owl#hasTopping"/>
                <owl:someValuesFrom rdf:resource="http://www.cgts.com/pizza/pizza.owl#MozzarellaTopping"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.cgts.com/pizza/pizza.owl#hasTopping"/>
                <owl:someValuesFrom rdf:resource="http://www.cgts.com/pizza/pizza.owl#PeperoniSausageTopping"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.cgts.com/pizza/pizza.owl#hasTopping"/>
                <owl:someValuesFrom rdf:resource="http://www.cgts.com/pizza/pizza.owl#TomatoTopping"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.cgts.com/pizza/pizza.owl#hasTopping"/>
                <owl:allValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://www.cgts.com/pizza/pizza.owl#HotGreenPepperTopping"/>
                            <rdf:Description rdf:about="http://www.cgts.com/pizza/pizza.owl#JalapenoPepperTopping"/>
                            <rdf:Description rdf:about="http://www.cgts.com/pizza/pizza.owl#MozzarellaTopping"/>
                            <rdf:Description rdf:about="http://www.cgts.com/pizza/pizza.owl#PeperoniSausageTopping"/>
                            <rdf:Description rdf:about="http://www.cgts.com/pizza/pizza.owl#TomatoTopping"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.cgts.com/pizza/pizza.owl#hasCountryOfOrigin"/>
                <owl:hasValue rdf:resource="http://www.cgts.com/pizza/pizza.owl#America"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://www.cgts.com/pizza/pizza.owl#AnchoviesTopping -->

    <owl:Class rdf:about="http://www.cgts.com/pizza/pizza.owl#AnchoviesTopping">
        <rdfs:subClassOf rdf:resource="http://www.cgts.com/pizza/pizza.owl#FishTopping"/>
    </owl:Class>
    


    <!-- http://www.cgts.com/pizza/pizza.owl#ArtichokeTopping -->

    <owl:Class rdf:about="http://www.cgts.com/pizza/pizza.owl#ArtichokeTopping">
        <rdfs:subClassOf rdf:resource="http://www.cgts.com/pizza/pizza.owl#VegetableTopping"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.cgts.com/pizza/pizza.owl#hasSpiciness"/>
                <owl:someValuesFrom rdf:resource="http://www.cgts.com/pizza/pizza.owl#Mild"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://www.cgts.com/pizza/pizza.owl#AsparagusTopping -->

    <owl:Class rdf:about="http://www.cgts.com/pizza/pizza.owl#AsparagusTopping">
        <rdfs:subClassOf rdf:resource="http://www.cgts.com/pizza/pizza.owl#VegetableTopping"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.cgts.com/pizza/pizza.owl#hasSpiciness"/>
                <owl:someValuesFrom rdf:resource="http://www.cgts.com/pizza/pizza.owl#Mild"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://www.cgts.com/pizza/pizza.owl#Cajun -->

    <owl:Class rdf:about="http://www.cgts.com/pizza/pizza.owl#Cajun">
        <rdfs:subClassOf rdf:resource="http://www.cgts.com/pizza/pizza.owl#NamedPizza"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.cgts.com/pizza/pizza.owl#hasTopping"/>
                <owl:someValuesFrom rdf:resource="http://www.cgts.com/pizza/pizza.owl#MozzarellaTopping"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.cgts.com/pizza/pizza.owl#hasTopping"/>
                <owl:someValuesFrom rdf:resource="http://www.cgts.com/pizza/pizza.owl#OnionTopping"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.cgts.com/pizza/pizza.owl#hasTopping"/>
                <owl:someValuesFrom rdf:resource="http://www.cgts.com/pizza/pizza.owl#PeperonataTopping"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.cgts.com/pizza/pizza.owl#hasTopping"/>
                <owl:someValuesFrom rdf:resource="http://www.cgts.com/pizza/pizza.owl#PrawnsTopping"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.cgts.com/pizza/pizza.owl#hasTopping"/>
                <owl:someValuesFrom rdf:resource="http://www.cgts.com/pizza/pizza.owl#TobascoPepperSauce"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.cgts.com/pizza/pizza.owl#hasTopping"/>
                <owl:someValuesFrom rdf:resource="http://www.cgts.com/pizza/pizza.owl#TomatoTopping"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.cgts.com/pizza/pizza.owl#hasTopping"/>
                <owl:allValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://www.cgts.com/pizza/pizza.owl#MozzarellaTopping"/>
                            <rdf:Description rdf:about="http://www.cgts.com/pizza/pizza.owl#OnionTopping"/>
                            <rdf:Description rdf:about="http://www.cgts.com/pizza/pizza.owl#PeperonataTopping"/>
                            <rdf:Description rdf:about="http://www.cgts.com/pizza/pizza.owl#PrawnsTopping"/>
                            <rdf:Description rdf:about="http://www.cgts.com/pizza/pizza.owl#TobascoPepperSauce"/>
                            <rdf:Description rdf:about="http://www.cgts.com/pizza/pizza.owl#TomatoTopping"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://www.cgts.com/pizza/pizza.owl#CajunSpiceTopping -->

    <owl:Class rdf:about="http://www.cgts.com/pizza/pizza.owl#CajunSpiceTopping">
        <rdfs:subClassOf rdf:resource="http://www.cgts.com/pizza/pizza.owl#HerbSpiceTopping"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.cgts.com/pizza/pizza.owl#hasSpiciness"/>
                <owl:someValuesFrom rdf:resource="http://www.cgts.com/pizza/pizza.owl#Hot"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="http://www.cgts.com/pizza/pizza.owl#RosemaryTopping"/>
    </owl:Class>
    


    <!-- http://www.cgts.com/pizza/pizza.owl#CaperTopping -->

    <owl:Class rdf:about="http://www.cgts.com/pizza/pizza.owl#CaperTopping">
        <rdfs:subClassOf rdf:resource="http://www.cgts.com/pizza/pizza.owl#VegetableTopping"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.cgts.com/pizza/pizza.owl#hasSpiciness"/>
                <owl:someValuesFrom rdf:resource="http://www.cgts.com/pizza/pizza.owl#Mild"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://www.cgts.com/pizza/pizza.owl#Capricciosa -->

    <owl:Class rdf:about="http://www.cgts.com/pizza/pizza.owl#Capricciosa">
        <rdfs:subClassOf rdf:resource="http://www.cgts.com/pizza/pizza.owl#NamedPizza"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.cgts.com/pizza/pizza.owl#hasTopping"/>
                <owl:someValuesFrom rdf:resource="http://www.cgts.com/pizza/pizza.owl#AnchoviesTopping"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.cgts.com/pizza/pizza.owl#hasTopping"/>
                <owl:someValuesFrom rdf:resource="http://www.cgts.com/pizza/pizza.owl#CaperTopping"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.cgts.com/pizza/pizza.owl#hasTopping"/>
                <owl:someValuesFrom rdf:resource="http://www.cgts.com/pizza/pizza.owl#HamTopping"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.cgts.com/pizza/pizza.owl#hasTopping"/>
                <owl:someValuesFrom rdf:resource="http://www.cgts.com/pizza/pizza.owl#MozzarellaTopping"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.cgts.com/pizza/pizza.owl#hasTopping"/>
                <owl:someValuesFrom rdf:resource="http://www.cgts.com/pizza/pizza.owl#OliveTopping"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.cgts.com/pizza/pizza.owl#hasTopping"/>
                <owl:someValuesFrom rdf:resource="http://www.cgts.com/pizza/pizza.owl#PeperonataTopping"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.cgts.com/pizza/pizza.owl#hasTopping"/>
                <owl:someValuesFrom rdf:resource="http://www.cgts.com/pizza/pizza.owl#TomatoTopping"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.cgts.com/pizza/pizza.owl#hasTopping"/>
                <owl:allValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://www.cgts.com/pizza/pizza.owl#AnchoviesTopping"/>
                            <rdf:Description rdf:about="http://www.cgts.com/pizza/pizza.owl#CaperTopping"/>
                            <rdf:Description rdf:about="http://www.cgts.com/pizza/pizza.owl#HamTopping"/>
                            <rdf:Description rdf:about="http://www.cgts.com/pizza/pizza.owl#MozzarellaTopping"/>
                            <rdf:Description rdf:about="http://www.cgts.com/pizza/pizza.owl#OliveTopping"/>
                            <rdf:Description rdf:about="http://www.cgts.com/pizza/pizza.owl#PeperonataTopping"/>
                            <rdf:Description rdf:about="http://www.cgts.com/pizza/pizza.owl#TomatoTopping"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://www.cgts.com/pizza/pizza.owl#Caprina -->

    <owl:Class rdf:about="http://www.cgts.com/pizza/pizza.owl#Caprina">
